###########
## 1.1 Intro to DevOps
###########

mkdir myWebApp5
cd myWebApp5

#git config --global init.defaultBranch main

git init

git config --global user.name "Gitte Vermeiren"
git config --global user.email "gitte.vermeiren@gmail.com"

# In case you are behind a proxy, you can set the proxy settings for git as follows:
# git config --global http.proxy
# http://proxyUsername:proxyPassword@proxy.server.com:port

dotnet new mvc

dotnet build
dotnet run

git status
# notice bin and obj directories are also in the output list, we don't want to track those in git, so we will add them to a .gitignore file
# Select a file in the bin folder -- F1 > Git: Add to .gitignore
# Notice file counter goes down in Git
git status

# ask GH copilot to create a standard .gitignore file for a .NET MVC project

git add .
git commit -m "Initial commit of my Web App"

git branch --list

git branch feature-devops-home-page
git status
git branch --list
git checkout feature-devops-home-page
git status
git branch --list

# Make changes to the home page, for example by changing the text in the Index.cshtml file
#################
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://azure.microsoft.com/services/devops/">Azure DevOps</a>.</p>
</div>

##################

git status
git add .
git commit -m "updated welcome page."
git status

git checkout main
git merge feature-devops-home-page

git branch --delete feature-devops-home-page
git branch --list

git log -v
git log -p

