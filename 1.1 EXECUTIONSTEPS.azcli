###########
# VC with Azure DevOps
###########

# Create a new repository in Azure DevOps and copy the URL for cloning

cd ..
mkdir myWebAppAZDORepo
cd myWebAppAZDORepo

git clone https://MCAPSGitteDemo@dev.azure.com/MCAPSGitteDemo/Full%20Demo%20Project/_git/vcDemo

cd vcDemo

dotnet new mvc

git status
git add .
git commit -m "Initial commit of my Web App in Azure DevOps Repo"

git status
git push 

git branch feature-devops-home-page
git checkout feature-devops-home-page

# Make changes to the home page, for example by changing the text in the Index.cshtml file
#################
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://azure.microsoft.com/services/devops/">Azure DevOps</a>.</p>
</div>

##################

git status
git add .
git commit -m "updated welcome page."
git status

# This will not work, since there is no upstream branch for the feature branch, we will need to set that first
git push 

git push --set-upstream origin feature-devops-home-page

# Create new PR in Azure DevOps and complete it, merging the feature branch into main


###########
# VC with GitHub
###########

# Create a new repository in Azure DevOps and copy the URL for cloning

cd ../..
mkdir myWebAppGHRepo
cd myWebAppGHRepo

git clone https://github.com/vermegi/ghvcDemo.git

cd ghvcDemo

dotnet new mvc

git status
git add .
git commit -m "Initial commit of my Web App in Azure DevOps Repo"

git status
git push 

git branch feature-devops-home-page
git checkout feature-devops-home-page

# Make changes to the home page, for example by changing the text in the Index.cshtml file
#################
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://azure.microsoft.com/services/devops/">Azure DevOps</a>.</p>
</div>

##################

git status
git add .
git commit -m "updated welcome page."
git status

# This will not work, since there is no upstream branch for the feature branch, we will need to set that first
git push 

git push --set-upstream origin feature-devops-home-page

# Create new PR in GH and complete it, merging the feature branch into main

