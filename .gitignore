## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/
*.code-workspace

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache directory
.vs/

# Rider cache
.idea/
*.sln.iml

# NuGet Packages
*.nupkg
*.snupkg
.nuget/
*.nuget.props
*.nuget.targets

# NuGet v3's project.json files produces more ignorable files
*.nuget.dgspec.json
project.lock.json
project.assets.json
*.nuget.g.props
*.nuget.g.targets

# Miscellaneous temporary files
*.exe
*.dll
*.so
*.dylib
*.o
*.a

# Entity Framework
*.edmx.diagram

# App specific
appsettings.*.json
!appsettings.Development.json

# OS files
.DS_Store
Thumbs.db

# Test Results
TestResults/
*.trx
*.coverage

# Publish
PublishProfiles/
*.publish.xml

# dotnet core
.dotnet

# User secrets
**/secrets.json

# Local environment variables
.env
.env.local
